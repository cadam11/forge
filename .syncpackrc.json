{
  "versionGroups": [
    {
      "label": "TypeScript should be pinned (bumping past 5.4 is a follow-up — see pnpm-workspace.yaml)",
      "packages": ["**"],
      "dependencies": ["typescript"],
      "pinVersion": "~5.4.5"
    },
    {
      "label": "Use consistent Electron version",
      "packages": ["**"],
      "dependencies": ["electron"],
      "policy": "sameRange"
    },
    {
      "label": "ESLint majors coexist: the root config is eslintrc/8, the renderer is flat/9",
      "packages": ["**"],
      "dependencies": ["eslint", "eslint-config-prettier"],
      "isIgnored": true
    }
  ],
  "semverGroups": [
    {
      "range": "",
      "dependencyTypes": ["prod", "dev"],
      "dependencies": ["**"],
      "packages": ["**"]
    }
  ]
}
